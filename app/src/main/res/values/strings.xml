    <string name="guide_toolbar_title">Cards Extraction Guide</string>
    <string name="guide_section_active_title">1. Extracting Active Cards File</string>
    <string name="guide_active_step1">Go to "Users" screen inside your control panel.</string>
    <string name="guide_active_step2">Change "Status" to <b>Active</b> (unused cards or cards that are used but not expired yet).</string>
    <string name="guide_active_step3">Select "Is Sold" to <b>Yes</b> (authenticated cards).</string>
    <string name="guide_active_step4">Click on the blue <b>Search</b> button to filter results.</string>
    <string name="guide_active_step5">Click on the <b>Green Download Button</b> on the right to export the Excel file.</string>
    <string name="guide_section_sold_title">2. Extracting Sold/Exported Files</string>
    <string name="guide_sold_step1">Go to "Exported Files" screen in your control panel.</string>
    <string name="guide_sold_step2">Download all required files by clicking the <b>Download Icon</b> on the right of each file based on your target date range.</string>
    <string name="guide_sold_step3">Use the pagination buttons (1, 2, 3, 4, 5…) at the bottom to navigate between pages.</string>
    <string name="guide_sold_step4">For a better experience, change the items-per-page dropdown (default 10) to the largest number possible to view and download all files easily if there are many files.</string>
