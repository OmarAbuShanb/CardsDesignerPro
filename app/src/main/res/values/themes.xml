<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CardsDesignerPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:supportsRtl">true</item>
    </style>

    <style name="Theme.CardsDesignerPro" parent="Base.Theme.CardsDesignerPro" />

    <!-- Toolbar -->
    <style name="Widget.CardsDesignerPro.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:elevation">4dp</item>
    </style>

    <!-- BottomSheet -->
    <style name="Widget.CardsDesignerPro.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CardsDesignerPro.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.CardsDesignerPro.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <!-- Dialogs -->
    <style name="Widget.CardsDesignerPro.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CardsDesignerPro.Dialog</item>
    </style>

    <style name="ShapeAppearance.CardsDesignerPro.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

</resources>