<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_text"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="@string/prop_text_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|top"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="1"
                android:textDirection="anyRtl" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Text color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_text_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_text_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <dev.anonymous.cardsdesignerpro.common.widget.ColorHexFieldView
                android:id="@+id/field_text_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Bg color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_text_bg_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_bg_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <dev.anonymous.cardsdesignerpro.common.widget.ColorHexFieldView
                android:id="@+id/field_bg_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_bg_color"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_remove"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bold -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/prop_bold" />

        <!-- Text alignment -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_text_alignment"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_text_align"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_align_start"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/prop_align_start"
                android:text=""
                app:icon="@drawable/ic_align_start"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_align_center"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/prop_align_center"
                android:text=""
                app:icon="@drawable/ic_align_center"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_align_end"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/prop_align_end"
                android:text=""
                app:icon="@drawable/ic_align_end"
                app:iconGravity="textStart" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Font -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_font"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <dev.anonymous.cardsdesignerpro.ui.common.TopScrollSpinner
            android:id="@+id/spinner_font"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp" />

        <!-- Font size -->
        <TextView
            android:id="@+id/tv_font_size_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prop_font_size"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:stepSize="1.0"
            android:valueFrom="10.0"
            android:valueTo="100.0"
            app:labelBehavior="floating" />

        <!-- Text stroke -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_text_stroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_enable_stroke" />

        <LinearLayout
            android:id="@+id/layout_text_stroke_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/prop_stroke_color"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                    android:id="@+id/cpv_stroke_color"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp" />

                <dev.anonymous.cardsdesignerpro.common.widget.ColorHexFieldView
                    android:id="@+id/field_stroke_color_hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_stroke_size_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prop_text_stroke"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_text_stroke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:stepSize="0.5"
                android:valueFrom="1.0"
                android:valueTo="10.0"
                app:labelBehavior="floating" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
