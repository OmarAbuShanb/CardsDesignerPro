<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Text content — layoutDirection=locale fixes reversed typing for LTR text -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_text"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/prop_text_content"
            android:layout_marginBottom="14dp"
            android:layoutDirection="locale">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="1"
                android:maxLines="6"
                android:gravity="start|top"
                android:textDirection="anyRtl"
                android:layoutDirection="locale" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Text color -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prop_text_color" android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_text_color"
                android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_text_color_hex" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodyMedium" android:text="#000000" />
        </LinearLayout>

        <!-- Bg color -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prop_text_bg_color" android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_bg_color"
                android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tv_bg_color_hex" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodyMedium" android:text="none" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_bg_color"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="إزالة"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bold -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prop_bold"
            android:layout_marginBottom="14dp" />

        <!-- Font -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prop_font" android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="6dp" />
        <Spinner android:id="@+id/spinner_font" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginBottom="14dp" />

        <!-- Font size -->
        <TextView android:id="@+id/tv_font_size_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prop_font_size" android:textAppearance="?attr/textAppearanceLabelMedium"
            android:layout_marginBottom="0dp" />
        <com.google.android.material.slider.Slider
            android:id="@+id/slider_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelBehavior="floating"
            android:valueFrom="10.0"
            android:valueTo="100.0"
            android:stepSize="1.0"
            android:layout_marginBottom="14dp" />

        <!-- Text stroke -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_text_stroke"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/prop_enable_stroke"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/layout_text_stroke_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/prop_stroke_color" android:textAppearance="?attr/textAppearanceLabelMedium"
                android:layout_marginBottom="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                    android:id="@+id/cpv_stroke_color"
                    android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" />
                <TextView android:id="@+id/tv_stroke_color_hex" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodyMedium" android:text="#000000" />
            </LinearLayout>

            <TextView android:id="@+id/tv_stroke_size_label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/prop_text_stroke" android:textAppearance="?attr/textAppearanceLabelMedium"
                android:layout_marginBottom="0dp" />
            <com.google.android.material.slider.Slider
                android:id="@+id/slider_text_stroke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:labelBehavior="floating"
                android:valueFrom="1.0"
                android:valueTo="10.0"
                android:stepSize="0.5"
                android:layout_marginBottom="14dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
