<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Short Numbers Toggle -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_qr_short_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/prop_qr_short_numbers"
            android:visibility="gone" />

        <!-- Host URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_host"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="@string/prop_host">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- QR foreground color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_qr_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_qr_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <dev.anonymous.cardsdesignerpro.common.widget.ColorHexFieldView
                android:id="@+id/field_qr_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- QR background color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_qr_bg_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_qr_bg_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <dev.anonymous.cardsdesignerpro.common.widget.ColorHexFieldView
                android:id="@+id/field_qr_bg_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Dark pixel shape -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_qr_pixel_shape"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/spinner_pixel_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" />

        <!-- Eye (ball + frame) shape -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_qr_eye_shape"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/spinner_eye_shape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" />

        <!-- Logo picker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_logo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/btn_pick_qr_logo" />

        <LinearLayout
            android:id="@+id/layout_selected_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorSurfaceVariant"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_logo_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/label_chosen_logo"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <ImageView
                    android:id="@+id/btn_remove_logo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_delete_24"
                    app:tint="?attr/colorError" />
            </LinearLayout>

            <!-- Tint Logo Checkbox -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_tint_logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/cb_tint_logo" />
        </LinearLayout>

        <!-- Logo size -->
        <TextView
            android:id="@+id/tv_logo_size_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prop_logo_size"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_logo_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:stepSize="1"
            android:valueFrom="5"
            android:valueTo="33"
            app:labelBehavior="floating" />

        <!-- Padding -->
        <TextView
            android:id="@+id/tv_padding_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prop_qr_padding"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_qr_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="25"
            app:labelBehavior="floating" />

    </LinearLayout>
</ScrollView>
