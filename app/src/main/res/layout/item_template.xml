<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.button.MaterialSplitButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:layoutDirection="rtl"
    android:padding="0dp"
    android:spacing="1dp">

    <Button
        android:id="@+id/btn_open_template"
        style="?attr/materialSplitButtonLeadingFilledStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="52dp"
        android:textAlignment="center"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_more"
        style="?attr/materialSplitButtonIconFilledStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        app:icon="@drawable/ic_arrow_drop_down_24" />

</com.google.android.material.button.MaterialSplitButton>
