<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_date_format"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/spinner_date_format"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_text_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_text_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="#000000"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Background color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_text_bg_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                android:id="@+id/cpv_bg_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_bg_color_hex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="—"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_bg_color"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_clear"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/prop_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_font"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <Spinner
            android:id="@+id/spinner_font"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tv_font_size_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prop_font_size"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:stepSize="1.0"
            android:valueFrom="10.0"
            android:valueTo="100.0"
            app:labelBehavior="floating" />

        <!-- Text stroke -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_text_stroke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_enable_stroke" />

        <LinearLayout
            android:id="@+id/layout_text_stroke_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/prop_stroke_color"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <dev.anonymous.cardsdesignerpro.common.widget.ColorPreviewView
                    android:id="@+id/cpv_stroke_color"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_stroke_color_hex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="#000000"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_stroke_size_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prop_text_stroke"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_text_stroke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:stepSize="0.5"
                android:valueFrom="1.0"
                android:valueTo="10.0"
                app:labelBehavior="floating" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
