<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_frame_color"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.anonymous.cardsdesignerpro.app.common.widget.ColorPreviewView
                android:id="@+id/cpv_frame_color"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp" />

            <dev.anonymous.cardsdesignerpro.app.common.widget.ColorHexFieldView
                android:id="@+id/field_frame_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/prop_frame_thickness"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <dev.anonymous.cardsdesignerpro.app.common.widget.StepperView
            android:id="@+id/stepper_thickness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tv_corner_radius_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prop_frame_corner_radius"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_corner_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="100"
            app:labelBehavior="floating" />

        <TextView
            android:id="@+id/tv_padding_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prop_frame_padding"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="14dp"
            android:stepSize="1"
            android:valueFrom="0"
            android:valueTo="60"
            app:labelBehavior="floating" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_dashed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/prop_frame_dashed" />

        <LinearLayout
            android:id="@+id/layout_dash_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_dash_length_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prop_frame_dash_length"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_dash_length"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:stepSize="1"
                android:valueFrom="2"
                android:valueTo="60"
                app:labelBehavior="floating" />

            <TextView
                android:id="@+id/tv_dash_gap_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prop_frame_dash_gap"
                android:textAppearance="?attr/textAppearanceLabelMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_dash_gap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="40"
                app:labelBehavior="floating" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_dash_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/prop_frame_dash_rounded" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
