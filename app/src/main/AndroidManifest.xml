<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Override minSdk 31 of Jetpack PDF Viewer since we only use it dynamically on Android 12+ -->
    <uses-sdk tools:overrideLibrary="androidx.pdf,
     androidx.pdf.document.service,
      androidx.pdf.viewer.fragment" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="whatsapp" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CardsDesignerPro">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CardsDesignerPro.Splash"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.editor.EditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".ui.export.ExportCardsActivity"
            android:exported="false" />

        <activity-alias
            android:name=".ExportCardsAlias"
            android:label="@string/alias_export_cards"
            android:targetActivity=".ui.export.ExportCardsActivity"
            android:exported="true">
            <!-- فتح من مدير الملفات — يتطابق مع كل أنواع CSV و Excel و PDF -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/csv" />
                <data android:scheme="content" android:mimeType="text/comma-separated-values" />
                <data android:scheme="content"
                    android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>

            <!-- مشاركة من تطبيق آخر — بدون تحديد scheme -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.exportedfiles.ExportedFilesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.unusedcards.UnusedCardsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.unusedcards.UnusedCardsGuideActivity"
            android:exported="false" />

        <activity
            android:name=".ui.viewer.PdfViewerActivity"
            android:exported="false" />

        <activity-alias
            android:name=".PdfViewerAlias"
            android:label="@string/alias_pdf_preview"
            android:targetActivity=".ui.viewer.PdfViewerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ui.export.PdfExportService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>